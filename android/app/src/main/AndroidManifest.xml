<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.rogerskie09.uirsv4">

    <!-- CRITICAL: Allows the app to launch an Activity from the background (Android 10+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- CRITICAL: Allows the app to physically turn on the screen hardware -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- CRITICAL: Required for Android 13+ to show notifications at all -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Alarm & Sound Permissions -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Reliability Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- Location & Network -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.SEND_SMS" />
    
    <!-- Services (Required for Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"> 
        
        <!-- Sets the default channel for FCM if one isn't specified in payload -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="critical_alerts"
            tools:replace="android:value" />
            
        <!-- Sets the default icon. Without this, notifications might fail silently -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <activity
            android:name="com.rogerskie09.uirsv4.MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:showOnLockScreen="true" 
            android:turnScreenOn="true"
            android:theme="@style/Theme.App.SplashScreen"
            android:exported="true"
            
            android:screenOrientation="portrait"
            tools:node="merge"> 
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="exp+uirs-v4"/>
            </intent-filter>
        </activity>
        <activity 
            android:name="com.rogerskie09.uirsv4.EmergencyAlertActivity"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AppCompat.NoActionBar" 
            android:exported="false" />

        <service 
            android:name="com.rogerskie09.uirsv4.EmergencyAlertService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|mediaPlayback" />
        <!-- 
             Your Custom FCM Service 
             Using full package name to be 100% sure it's found.
        -->
        <service
            android:name="com.rogerskie09.uirsv4.SocketService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            
        <receiver
            android:name=".RestarterReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rogerskie09.RESTART_SOCKET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ✅ ADDED: Register the Stop Button Receiver here -->
        <receiver 
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <service
            android:name="com.rogerskie09.uirsv4.MyFirebaseMessagingService"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        
        <!-- 
             DISABLE DEFAULT REACT NATIVE FIREBASE SERVICE 
             This prevents the library from stealing the event before your custom service sees it.
        -->
        <service
            android:name="io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService"
            tools:node="remove" />

        <!-- Notifee Service for standard notifications -->
        <service 
            android:name="app.notifee.core.ForegroundService" 
            android:foregroundServiceType="remoteMessaging"
            tools:replace="android:foregroundServiceType" />

    </application>
</manifest>